# Kernel options for rock-4se-dfr0678-dsi-bridge.dtbo (Armbian rockchip64).
# Armbian's stock rockchip64 kernels leave the first two unset.
CONFIG_DRM_TOSHIBA_TC358762=m
CONFIG_REGULATOR_RASPBERRYPI_TOUCHSCREEN_ATTINY=m
CONFIG_DRM_PANEL_SIMPLE=m
# Normally already enabled; listed because the drivers above depend on them.
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
