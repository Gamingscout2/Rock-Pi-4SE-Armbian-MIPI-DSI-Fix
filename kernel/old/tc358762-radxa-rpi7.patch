 };
 
 static int tc358762_clear_error(struct mipi_dsi_device *dsi)
@@ -196,6 +204,56 @@ static int tc358762_init(struct tc358762 *ctx)
 	return 0;
 }
 
+static int tc358762_init_rpi7_radxa(struct tc358762 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	int ret;
+
+	ret = tc358762_write(dsi, DSI_LANEENABLE, 0x00000003);
+	if (ret < 0)
+		return ret;
+
+	ret = tc358762_write(dsi, PPI_D0S_CLRSIPOCOUNT, 0x0c);
+	if (ret < 0)
+		return ret;
+
+	ret = tc358762_write(dsi, PPI_D1S_CLRSIPOCOUNT, 0x0c);
+	if (ret < 0)
+		return ret;
+
+	ret = tc358762_write(dsi, PPI_D0S_ATMR, 0x00);
+	if (ret < 0)
+		return ret;
+
+	ret = tc358762_write(dsi, PPI_D1S_ATMR, 0x00);
+	if (ret < 0)
+		return ret;
+
+	ret = tc358762_write(dsi, PPI_LPTXTIMECNT, 0x15);
+	if (ret < 0)
+		return ret;
+
+	ret = tc358762_write(dsi, SPICMR, 0x60);
+	if (ret < 0)
+		return ret;
+
+	tc358762_write(dsi, LCDCTRL, 0x00100152);
+	tc358762_write(dsi, LCD_HSR_HBPR, 0x002c0002);
+	tc358762_write(dsi, LCD_HDISPR_HFPR, 0x00360320);
+	tc358762_write(dsi, LCD_VSR_VBPR, 0x00160002);
+	tc358762_write(dsi, LCD_VDISPR_VFPR, 0x003101e0);
+	tc358762_write(dsi, LCD_VFUEN, 0x01);
+	tc358762_write(dsi, SYSCTRL, 0x040f);
+	tc358762_write(dsi, PPI_STARTPPI, 0x01);
+	tc358762_write(dsi, DSI_STARTDSI, 0x01);
+	tc358762_write(dsi, LCD_RDPKTLN, 0x03);
+
+	usleep_range(10, 20);
+	return tc358762_clear_error(ctx->dsi);
+}
+
 static int tc358762_enable(struct drm_bridge *bridge)
 {
 	struct tc358762 *ctx = bridge_to_tc358762(bridge);
