+#define LCD_HSR_HBPR		0x24
+#define LCD_HDISPR_HFPR		0x28
+#define LCD_VSR_VBPR		0x2c
+#define LCD_VDISPR_VFPR		0x30
+#define LCD_VFUEN		0x34
+#define LCD_RDPKTLN		0x10
 
 #define VER_REG_CHIPID		0x0000
 #define VER_REG_INITIAL		0x0002
@@ -80,6 +87,7 @@ struct tc358762 {
 	struct gpio_desc *reset_gpio;
 	struct gpio_desc *enable_gpio;
 	bool pre_enabled;
