// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * EXPERIMENTAL: DFR0678 on the ROCK 4SE, set up to match the working Radxa OS
 * kernel as closely as mainline allows:
 *
 * - DSI1 gets its PLL from DSI0          (rockchip,dsi-dsi0)
 * - DSI1 runs at Radxa's 696 Mbps/lane   (rockchip,lane-rate)
 * - TC358762 uses Radxa's init sequence, burst mode, no EoT packets
 *                                        (toshiba,radxa-init)
 * - the panel mode is Radxa's 26 MHz 800x480 timing (panel-dpi)
 *
 * Needs a kernel with rk3399-dsi1-dsi0-pll.patch,
 * dsi-lane-rate-override.patch and tc358762-radxa-init.patch, and without
 * dfr0678-radxa-timing.patch (this overlay sets the mode itself).
 * Do not load together with another overlay that claims i2c1 0x45.
 */

/dts-v1/;
/plugin/;

&{/} {
	panel {
		compatible = "panel-dpi";
		power-supply = <&dfr0678_mcu>;
		backlight = <&dfr0678_mcu>;
		width-mm = <154>;
		height-mm = <86>;

		panel-timing {
			clock-frequency = <26000000>;
			hactive = <800>;
			vactive = <480>;
			hfront-porch = <1>;
			hsync-len = <5>;
			hback-porch = <40>;
			vfront-porch = <7>;
			vsync-len = <1>;
			vback-porch = <21>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <0>;
			pixelclk-active = <0>;
		};

		port {
			panel_in_bridge: endpoint {
				remote-endpoint = <&bridge_out_panel>;
			};
		};
	};
};

&i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	dfr0678_mcu: regulator@45 {
		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
		reg = <0x45>;
	};
};

&mipi_dsi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	rockchip,dsi-dsi0 = <&mipi_dsi>;
	rockchip,lane-rate = <696>;

	bridge@0 {
		compatible = "toshiba,tc358762";
		reg = <0>;
		vddc-supply = <&dfr0678_mcu>;
		toshiba,radxa-init;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				bridge_in_dsi1: endpoint {
					remote-endpoint = <&dsi1_out_bridge>;
				};
			};

			port@1 {
				reg = <1>;

				bridge_out_panel: endpoint {
					remote-endpoint = <&panel_in_bridge>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dsi1_out_bridge: endpoint {
				remote-endpoint = <&bridge_in_dsi1>;
			};
		};
	};
};
