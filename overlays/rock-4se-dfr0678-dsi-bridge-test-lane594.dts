// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * EXPERIMENTAL: DFR0678 on the ROCK 4SE with the mainline tc358762 driver and
 * panel-simple mode (800x480, 24.75 MHz), with DSI1 fed by DSI0's PLL
 * (rockchip,dsi-dsi0) and its lane rate pinned to 24 x the pixel clock
 * (rockchip,lane-rate = 594; the PLL lands on 592 Mbps).
 *
 * Tests whether the blank screen is the TC358762 deriving its pixel clock
 * from the DSI byte clock (lane rate / 24): at mainline's default 752 Mbps
 * that is ~31 MHz against a 24.75 MHz input.
 *
 * Needs a kernel with rk3399-dsi1-dsi0-pll.patch and
 * dsi-lane-rate-override.patch, and without dfr0678-radxa-timing.patch.
 * Do not load together with another overlay that claims i2c1 0x45.
 */

/dts-v1/;
/plugin/;

&{/} {
	panel {
		compatible = "powertip,ph800480t013-idf02";
		power-supply = <&dfr0678_mcu>;
		backlight = <&dfr0678_mcu>;

		port {
			panel_in_bridge: endpoint {
				remote-endpoint = <&bridge_out_panel>;
			};
		};
	};
};

&i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	dfr0678_mcu: regulator@45 {
		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
		reg = <0x45>;
	};
};

&mipi_dsi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	rockchip,dsi-dsi0 = <&mipi_dsi>;
	rockchip,lane-rate = <594>;

	bridge@0 {
		compatible = "toshiba,tc358762";
		reg = <0>;
		vddc-supply = <&dfr0678_mcu>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				bridge_in_dsi1: endpoint {
					remote-endpoint = <&dsi1_out_bridge>;
				};
			};

			port@1 {
				reg = <1>;

				bridge_out_panel: endpoint {
					remote-endpoint = <&panel_in_bridge>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dsi1_out_bridge: endpoint {
				remote-endpoint = <&bridge_in_dsi1>;
			};
		};
	};
};
