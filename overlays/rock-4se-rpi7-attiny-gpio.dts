// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Raspberry Pi 7" / DFR0678 touchscreen on the Radxa ROCK 4SE, mainline-style
 * ATTiny handling with Radxa's bridge setup.
 *
 * The mainline ATTiny regulator driver exposes the bridge/LCD reset line as a
 * GPIO (RST_BRIDGE_N). Mainline's tc358762 releases it from pre_enable only if
 * the bridge has a reset-gpios property, which none of the earlier overlays
 * had, so the bridge and LCD controller may have stayed in reset. This
 * overlay wires it up (gpio flag 0 = active high: logical 1 releases reset).
 *
 * Needs the kernel patches rk3399-dsi1-dsi0-pll, dsi-lane-rate-override,
 * dfr0678-radxa-timing and tc358762-rpi7-radxa-bringup, and no other overlay
 * touching I2C1 address 0x45.
 */

/dts-v1/;
/plugin/;

&{/} {
	panel {
		compatible = "powertip,ph800480t013-idf02";
		power-supply = <&rpi7_attiny>;
		backlight = <&rpi7_attiny>;

		port {
			panel_in_bridge: endpoint {
				remote-endpoint = <&bridge_out_panel>;
			};
		};
	};
};

&i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	rpi7_attiny: regulator@45 {
		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
		reg = <0x45>;
		gpio-controller;
		#gpio-cells = <2>;
	};
};

&mipi1_in_vopb {
	status = "disabled";
};

&mipi1_in_vopl {
	status = "okay";
};

&mipi_dsi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/* DSI0 supplies the shared PHY PLL while staying disabled */
	rockchip,dsi-dsi0 = <&mipi_dsi>;
	rockchip,lane-rate = <696>;

	bridge@0 {
		compatible = "toshiba,tc358762";
		reg = <0>;
		vddc-supply = <&rpi7_attiny>;
		reset-gpios = <&rpi7_attiny 0 0>;

		toshiba,radxa-rpi7-init;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				bridge_in_dsi1: endpoint {
					remote-endpoint = <&dsi1_out_bridge>;
				};
			};

			port@1 {
				reg = <1>;

				bridge_out_panel: endpoint {
					remote-endpoint = <&panel_in_bridge>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dsi1_out_bridge: endpoint {
				remote-endpoint = <&bridge_in_dsi1>;
			};
		};
	};
};
