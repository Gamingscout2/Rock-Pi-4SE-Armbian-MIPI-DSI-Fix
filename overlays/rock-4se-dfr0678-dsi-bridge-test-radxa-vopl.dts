/*
 * Experimental DFR0678 test matching Radxa's working DSI1-to-VOPL route.
 *
 * This is identical to test-radxa except that DSI1's VOPB input endpoint is
 * disabled and its VOPL input endpoint is enabled. Keep the Build 19 kernel
 * patches, 696 Mbps lane rate, Radxa TC358762 setup, and panel timing fixed.
 * DSI0 supplies the shared PHY PLL but its display host remains disabled.
 * Do not load with another overlay that claims I2C1 address 0x45.
 */

/dts-v1/;
/plugin/;

&{/} {
	panel {
		compatible = "panel-dpi";
		power-supply = <&dfr0678_mcu>;
		backlight = <&dfr0678_mcu>;
		width-mm = <154>;
		height-mm = <86>;

		panel-timing {
			clock-frequency = <26000000>;
			hactive = <800>;
			vactive = <480>;
			hfront-porch = <1>;
			hsync-len = <5>;
			hback-porch = <40>;
			vfront-porch = <7>;
			vsync-len = <1>;
			vback-porch = <21>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <0>;
			pixelclk-active = <0>;
		};

		port {
			panel_in_bridge: endpoint {
				remote-endpoint = <&bridge_out_panel>;
			};
		};
	};
};

&i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	dfr0678_mcu: regulator@45 {
		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
		reg = <0x45>;
	};
};

&mipi1_in_vopb {
	status = "disabled";
};

&mipi1_in_vopl {
	status = "okay";
};

&mipi_dsi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	rockchip,dsi-dsi0 = <&mipi_dsi>;
	rockchip,lane-rate = <696>;

	bridge@0 {
		compatible = "toshiba,tc358762";
		reg = <0>;
		vddc-supply = <&dfr0678_mcu>;
		toshiba,radxa-init;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				bridge_in_dsi1: endpoint {
					remote-endpoint = <&dsi1_out_bridge>;
				};
			};

			port@1 {
				reg = <1>;

				bridge_out_panel: endpoint {
					remote-endpoint = <&panel_in_bridge>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dsi1_out_bridge: endpoint {
				remote-endpoint = <&bridge_in_dsi1>;
			};
		};
	};
};
