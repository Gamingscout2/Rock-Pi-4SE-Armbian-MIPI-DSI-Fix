// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Raspberry Pi 7" Touchscreen Support for Radxa Rock Pi 4SE
 *
 * This overlay enables the Raspberry Pi 7" touchscreen (DFR0678) on the Radxa
 * Rock Pi 4SE using:
 * - The RK3399 DSI1 controller (mipi_dsi1) connected via MIPI connector J8204
 * - VOPL (Video Output Processor Lite) routed to DSI1
 * - Toshiba TC358762 DSI-to-DPI bridge with Radxa + RPi optimizations
 * - Powertip PH800480T013-IDF02 panel descriptor
 * - ATTiny85 MCU for power sequencing and backlight control
 *
 * Requirements:
 * - Kernel patch: tc358762-rpi7-touchscreen-radxa.patch
 * - The dfr0678-radxa-timing.patch to set the Powertip panel mode
 * - Armbian 6.18.60-current kernel with CONFIG_DRM_TOSHIBA_TC358762 enabled
 *
 * Do not load with multiple overlays claiming I2C1 address 0x45.
 */

/dts-v1/;
/plugin/;

&{/} {
	panel {
		compatible = "powertip,ph800480t013-idf02";
		power-supply = <&dfr0678_mcu>;
		backlight = <&dfr0678_mcu>;

		port {
			panel_in_bridge: endpoint {
				remote-endpoint = <&bridge_out_panel>;
			};
		};
	};
};

&i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	dfr0678_mcu: regulator@45 {
		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
		reg = <0x45>;
	};
};

/* Route DSI1 through VOPL (Video Output Processor Lite) */
&mipi1_in_vopb {
	status = "disabled";
};

&mipi1_in_vopl {
	status = "okay";
};

/* Configure DSI1 with TC358762 bridge and RPi 7" panel */
&mipi_dsi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	
	/* DSI0 supplies the shared PHY PLL while staying disabled */
	rockchip,dsi-dsi0 = <&mipi_dsi>;
	
	/* Lane rate optimized for Radxa Rock 4SE + TC358762 + RPi 7" panel */
	rockchip,lane-rate = <696>;

	bridge@0 {
		compatible = "toshiba,tc358762";
		reg = <0>;
		vddc-supply = <&dfr0678_mcu>;
		
		/* Enable the Radxa + RPi 7" touchscreen optimized init sequence */
		toshiba,radxa-rpi7-init;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/* DSI1 input port */
			port@0 {
				reg = <0>;

				bridge_in_dsi1: endpoint {
					remote-endpoint = <&dsi1_out_bridge>;
				};
			};

			/* DPI output port to panel */
			port@1 {
				reg = <1>;

				bridge_out_panel: endpoint {
					remote-endpoint = <&panel_in_bridge>;
				};
			};
		};
	};

	/* DSI1 output endpoint */
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dsi1_out_bridge: endpoint {
				remote-endpoint = <&bridge_in_dsi1>;
			};
		};
	};
};
